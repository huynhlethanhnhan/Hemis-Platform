# =====================================================================
# Sao chep tep nay thanh .env va dien gia tri that.
# TUYET DOI KHONG commit tep .env len kho ma nguon.
# =====================================================================

# --- Co so du lieu ---
DB_URL=jdbc:postgresql://localhost:5432/hemis
DB_USER=hemis
DB_PASSWORD=doi-mat-khau-nay

# --- Ket noi HEMIS ---
# Tat ca cac gia tri duoi day do Cuc Khoa hoc, Cong nghe va Thong tin (Bo GDDT) cap.
# Khi chua duoc cap, tro ve WireMock chay o localhost:8089 de phat trien song song.
HEMIS_SSO_URL=http://localhost:8089
HEMIS_GATEWAY_URL=http://localhost:8089

HEMIS_CLIENT_ID=password
HEMIS_CLIENT_SECRET=
HEMIS_USERNAME=
HEMIS_PASSWORD=

# Id co so giao duc (Guid 36 ky tu) do Bo cap
HEMIS_DON_VI_ID=00000000-0000-0000-0000-000000000000
HEMIS_MA_DON_VI=
HEMIS_TEN_DON_VI=Truong Dai hoc Su pham Thanh pho Ho Chi Minh

# Dinh danh he thong nguon, duoc HEMIS ghi vao nhat ky
HEMIS_DOMAIN_CONNECT=hemis-dwh.hcmue.edu.vn

# --- Ky so ---
# agent  : tac nhan tren tram ky so keo viec (chinh thuc Giai doan 1)
# manual  : xuat tep XML de ky thu cong tren cong HEMIS (du phong)
HEMIS_SIGNING_MODE=agent
HEMIS_STORAGE_DIR=./data/hemis-packages

# Token dung chung giua cong tich hop va tac nhan ky so.
# Sinh bang: openssl rand -hex 32
HEMIS_AGENT_TOKEN=doi-gia-tri-nay

# --- Ung dung ---
APP_PORT=8080
